# ══════════════════════════════════════════════════════════════════
#  MNM Learn English — Environment Variables
#  Sao chép file này thành .env và điền giá trị thực tế
#  KHÔNG commit file .env lên git
# ══════════════════════════════════════════════════════════════════

# ─── Django ───────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-charsa
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,backend
FRONTEND_URL=http://localhost:5173

# ─── Database (PostgreSQL) ────────────────────────────────────────
DB_NAME=mnm_learnenglish
DB_USER=postgres
DB_PASSWORD=123321!@
DB_HOST=postgres
DB_PORT=5432

# ─── Cache (Redis) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
# URL dùng cho django-redis cache backend
REDIS_URL=redis://:redispassword@redis:6379/0
# URL dùng cho Celery broker (nếu có task queue)
CELERY_BROKER_URL=redis://:redispassword@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword@redis:6379/2

# ─── JWT (djangorestframework-simplejwt) ─────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-to-another-random-secret-key

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Email ────────────────────────────────────────────────────────
# Development: dùng Mailtrap sandbox (https://mailtrap.io)
# Production: thay bằng SMTP thật (Gmail, SendGrid, SES...)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-mailtrap-user
EMAIL_HOST_PASSWORD=your-mailtrap-password
DEFAULT_FROM_EMAIL=MNM Learn English <noreply@mnm-english.com>

# ─── Storage (Media / Static) ─────────────────────────────────────
MEDIA_URL=/media/
STATIC_URL=/static/
# Bật để dùng AWS S3 thay cho local storage (production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1

# ─── Frontend (Vite) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=MNM Learn English
VITE_APP_VERSION=1.0.0

# ─── Ports (docker-compose) ───────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=logs/

# ─── Pagination ───────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
