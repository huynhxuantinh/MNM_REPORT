# NoroStu environment template
# Copy this file to .env and adjust values for your environment.
# Never commit .env to git.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,backend
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_NAME=norostu
DB_USER=postgres
DB_PASSWORD=change-me-db-password
DB_HOST=postgres
DB_PORT=5432

# Cache / Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-to-another-random-secret-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (dev: Mailtrap)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me-mailtrap-user
EMAIL_HOST_PASSWORD=change-me-mailtrap-password
DEFAULT_FROM_EMAIL=NoroStu <noreply@norostu.com>

# Storage
MEDIA_URL=/media/
STATIC_URL=/static/
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=NoroStu
VITE_APP_VERSION=1.0.0
VITE_SITE_URL=https://norostu.com

# Docker ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Logging / pagination
LOG_LEVEL=DEBUG
LOG_DIR=logs/
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
